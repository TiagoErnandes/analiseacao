# Copie para ".env.production" NA VPS (nunca commitar o arquivo real) e preencha.

TZ=America/Sao_Paulo

# Postgres (container oficial). Gere a senha com: openssl rand -hex 24
POSTGRES_USER=analiseacao
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=analiseacao

# Conexão do app (host = nome do serviço no docker-compose; mesma senha de cima)
DATABASE_URL=postgres://analiseacao:troque_por_uma_senha_forte@postgres:5432/analiseacao

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: chave GRÁTIS do Google Gemini (https://aistudio.google.com/apikey) para a pesquisa de notícias do dia.
# Sem ela, o modo Econômico decide sem notícias e o Completo pesquisa com o Claude Haiku (pago).
GEMINI_API_KEY=

# Horário da análise (cron). Padrão: segunda a sexta às 7h de Brasília
ANALISE_CRON=0 7 * * 1-5
