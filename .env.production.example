# Copie para ".env.production" NA VPS (nunca commitar o arquivo real) e preencha.

TZ=America/Sao_Paulo

# Postgres (container oficial). Gere a senha com: openssl rand -hex 24
POSTGRES_USER=analiseacao
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=analiseacao

# Conexão do app (host = nome do serviço no docker-compose; mesma senha de cima)
DATABASE_URL=postgres://analiseacao:troque_por_uma_senha_forte@postgres:5432/analiseacao

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey). No Google, quem é grátis ou pago é o PROJETO da chave.
# Chave de um projeto SEM faturamento: modo "Grátis (Gemini)", sem custo e sem Busca Google.
GEMINI_API_KEY=
# Opcional: chave de um projeto COM faturamento: modo "Gemini com Busca Google" (cobra os tokens; 5.000 buscas/mês grátis).
# Também é usada na pesquisa de notícias dos modos Econômico e Completo.
GEMINI_API_KEY_PAGO=

# Alertas de venda no celular (escolha um ou os dois).
# Telegram: crie um bot com o @BotFather (ele dá o token) e mande qualquer mensagem para o bot;
# o chat id aparece em https://api.telegram.org/bot<TOKEN>/getUpdates (campo "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy (sem cadastro): instale o app ntfy no celular e assine um tópico com nome difícil de adivinhar.
NTFY_TOPICO=
# Frequência do vigia de alertas (cron). Padrão: a cada 30 minutos, das 7h às 22h
# VIGIA_CRON=*/30 7-22 * * *

# Horário da análise (cron). Padrão: segunda a sexta às 7h de Brasília
ANALISE_CRON=0 7 * * 1-5
